<!-- header.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem; /* Adjust padding for spacing */
        }
        .nav-links {
            margin-left: auto;
            padding-right: 2rem; /* Adjust padding for spacing */
        }
    </style>
</head>
<body class="font-['helvetica_now_display'] bg-gray-100">
    <!-- Navbar with gradient background, reduced bottom padding -->
    <nav class="w-full bg-gradient-to-r from-indigo-500 via-purple-500 to-indigo-500 shadow-lg sticky top-0 z-10 py-2.5">
        <div class="navbar">
            <!-- Brand Title aligned to the left -->
            <h3 class="text-3xl font-bold text-white transition duration-300 transform hover:scale-105 hover:drop-shadow-lg">
                Scatch
            </h3>
            <% if (isAuthenticated) { %> <!-- Display links only if user is authenticated -->
                <ul class="flex space-x-8 nav-links"> <!-- Added nav-links class for custom CSS -->
                    <li>
                        <a href="/owners/products/create" class="text-white text-lg font-medium transition duration-300 hover:text-indigo-200 hover:underline hover:underline-offset-4">Owners</a>
                    </li>
                    <li>
                        <a href="/shop" class="text-white text-lg font-medium transition duration-300 hover:text-indigo-200 hover:underline hover:underline-offset-4">Shop</a>
                    </li>
                    <li>
                        <a href="/about" class="text-white text-lg font-medium transition duration-300 hover:text-indigo-200 hover:underline hover:underline-offset-4">About Us</a>
                    </li>
                    <li>
                        <a href="/products/cart" class="flex items-center gap-1 text-white text-lg font-medium transition duration-300 hover:text-indigo-200 hover:underline hover:underline-offset-4">
                            <i class="ri-shopping-cart-line"></i> Cart
                        </a>
                    </li>
                    <li>
                        <a href="/users/logout" class="text-red-500 text-lg font-semibold transition duration-300 hover:text-red-600 hover:underline hover:underline-offset-4">Logout</a>
                    </li>
                </ul>
            <% } else { %> <!-- If not authenticated, maybe a login link or nothing -->
                <ul class="flex space-x-8 nav-links">
                    <li>
                        <a href="/" class="text-white text-lg font-medium transition duration-300 hover:text-indigo-200 hover:underline hover:underline-offset-4">Login</a>
                    </li>
                </ul>
            <% } %>
        </div>
    </nav>
</body>
</html>