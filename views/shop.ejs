<!-- shop.ejs -->

<%- include('./partials/header') %>

<!-- Main container with limited width and adjusted padding -->
<div class="shop-container max-w-screen-xl mx-auto px-4 py-8">
    
    <!-- Heading -->
    <h1 class="text-3xl font-bold text-center mb-10 text-gray-800">Welcome to the Shop</h1> <!-- Centered heading -->

    <!-- Product listings with compact grid settings -->
    <div class="product-list grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% products.forEach(product => { %>
            <div class="product-card bg-white shadow-md rounded-lg overflow-hidden transition duration-300 transform hover:scale-105 hover:shadow-xl">
                
                <!-- Adjusted image container with hover brightness -->
                <div class="image-container w-full h-40 sm:h-48 flex items-center justify-center bg-gray-200 transition duration-300">
                    <img class="h-full object-cover transition duration-300 transform hover:brightness-90" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                </div>
                
                <div class="p-4">
                    <!-- Product name with hover color effect -->
                    <h2 class="text-lg sm:text-xl font-semibold mb-2 text-gray-900 hover:text-green-600 transition duration-300"><%= product.name %></h2>
                    <p class="text-gray-700 mb-4">Price: ₹<%= product.price %></p>
                    <% if (product.discount) { %>
                        <p class="text-green-500 font-medium">Discount: <%= product.discount %>% off</p>
                    <% } %>
                    
                    <!-- Button with compact padding -->
                    <form action="/products/addtocart/<%= product._id %>" method="POST">
                        <button type="submit" class="mt-4 px-3 py-2 bg-green-500 text-white rounded-lg transition duration-300 transform hover:bg-green-600 hover:scale-105">
                            Add to Cart
                        </button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- Error or success messages -->
    <% if (success.length > 0) { %>
        <div class="mt-6 text-center text-green-600 font-medium">
            <p><%= success %></p>
        </div>
    <% } %>

    <% if (error.length > 0) { %>
        <div class="mt-6 text-center text-red-600 font-medium">
            <p><%= error %></p>
        </div>
    <% } %>
</div>

<%- include('./partials/footer') %>
